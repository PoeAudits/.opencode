{
  "$schema": "https://opencode.ai/config.json",
  "theme": "rosepine",
  "autoupdate": false,
  "tui": {
    "scroll_speed": 3
  },
   "mcp": {
     "exa": {
       "type": "remote",
       "url": "https://mcp.exa.ai/mcp"
     },
  },
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-4-5": {
           "limit": {
             "context": 150000,
             "output": 50000
           },
         }
       }
     }
   },
   "agent": {
     "explore": {
       "model": "opencode/grok-code"
     },
   },
}
