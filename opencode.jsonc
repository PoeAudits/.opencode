{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "tui": {
    "scroll_speed": 3,
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "bash": {
      "npm *": "deny",
      "rm *": "ask",
      "grep *": "allow",
      "jq *": "allow",
      "glob *": "allow",
      "ls *": "allow",
    },
    "sudo *": "deny",
    "write": {
      "/tmp": "allow",
    },
    "rm": {
      "/tmp": "allow",
    },
    "todoread": "deny",
    "todowrite": "deny",
    "git push*": "deny",
    "doom_loop": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "~/thoughts/*": "allow",
      "~/.config/overlord/registry.yaml": "allow",
      "~/.config/opencode/*": "allow",
      "~/.agents/*": "allow",
      "~/Overlord/*": "allow",
    },

  },
}
