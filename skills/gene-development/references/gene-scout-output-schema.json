{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.schemas/gene-scout-output.schema.json",
  "title": "GeneScoutExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "result"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "search_terms"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "source_roots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "search_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": {
      "oneOf": [{ "$ref": "#/$defs/found" }, { "$ref": "#/$defs/not_found" }]
    }
  },
  "$defs": {
    "not_found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "confidence"],
      "properties": {
        "status": { "type": "string", "const": "not_found" },
        "reason": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "searched_locations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gene_candidate", "confidence"],
      "properties": {
        "status": { "type": "string", "const": "found" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "gene_candidate": { "$ref": "#/$defs/gene_candidate" }
      }
    },
    "gene_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_id",
        "title",
        "summary",
        "tags",
        "languages",
        "pattern_spec",
        "invariants",
        "edge_cases",
        "pitfalls",
        "provenance",
        "snippets_by_language"
      ],
      "properties": {
        "proposed_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "languages": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "pattern_spec": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 3
        },
        "invariants": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "edge_cases": { "type": "array", "items": { "type": "string" } },
        "pitfalls": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" },
          "minItems": 1
        },
        "snippets_by_language": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/snippet" }
          },
          "minProperties": 1
        },
        "dedupe_fingerprint": { "type": "string" },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_note", "search_terms"],
      "properties": {
        "origin_note": { "type": "string", "minLength": 1 },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "search_terms": { "type": "array", "items": { "type": "string" } },
        "captured_at": { "type": "string" }
      }
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "code"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "source_note": { "type": "string" },
        "why_relevant": { "type": "string" }
      }
    }
  }
}
